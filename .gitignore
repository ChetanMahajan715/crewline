# Python environment and caches
.venv/
__pycache__/
.pytest_cache/

# Secrets: your API key lives in .env and is never committed
.env

# Run output, created on your machine by every run
runs/*.jsonl
*.db

# Downloaded or written by runs
sandbox/*
!sandbox/.gitkeep

# Test data is its own repo: git clone it into test-data/ (see docs/GUIDE.md)
test-data/

# Personal files
.vscode/
*.docx
